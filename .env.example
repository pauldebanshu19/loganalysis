# --- upload limits ---------------------------------------------------------
MAX_UPLOAD_MB=100
MAX_LINE_KB=64
UPLOAD_IDLE_TIMEOUT_S=30

# --- concurrency -----------------------------------------------------------
MAX_CONCURRENT_ANALYSES=8
SLOT_WAIT_S=5

# --- API -------------------------------------------------------------------
RATE_LIMIT_PER_MIN=30
RESULT_TTL_S=3600
DEFAULT_SAMPLES=20
MAX_SAMPLES=100


# --- misc ------------------------------------------------------------------
ENV=development
LOG_LEVEL=INFO
